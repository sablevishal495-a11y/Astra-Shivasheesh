# Server Configuration
PORT=5001
FLASK_ENV=development

# PostgreSQL Database Connection URL
# Local example: postgresql://postgres:password@localhost:5432/astradb
# Cloud example (Neon / Supabase): postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/astradb

# Google OAuth 2.0 Web Client ID from Google Cloud Console
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Secret key for signing sessions / tokens
JWT_SECRET=change_this_to_a_secure_random_key_in_production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
